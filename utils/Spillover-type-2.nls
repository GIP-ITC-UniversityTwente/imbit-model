; For each patch with pop_frac, foi> 0, we calculate the amount of spillover exposed
; by determining the gm the patch belongs to, then use eqn
; spillover-exposed for each pop cat = (foi * pop_frac * pop_cat_gm)

to create-spillover-type-2
    ask patches with [pop_frac > 0 and foi > 0 and gm_id = [id] of myself] [
        
        let delta-S00000 pop_frac * [S00000] of myself * foi
        let delta-S11112 pop_frac * [S11112] of myself * foi
        let delta-S12112 pop_frac * [S12112] of myself * foi
        let delta-S13112 pop_frac * [S13112] of myself * foi
        let delta-S14212 pop_frac * [S14212] of myself * foi
        let delta-S14112 pop_frac * [S14112] of myself * foi
        let delta-S15111 pop_frac * [S15111] of myself * foi
        let delta-S26311 pop_frac * [S26311] of myself * foi
        let delta-S26312 pop_frac * [S26312] of myself * foi
        let delta-S26111 pop_frac * [S26111] of myself * foi
        let delta-S26112 pop_frac * [S26112] of myself * foi
        let delta-S36322 pop_frac * [S36322] of myself * foi
        let delta-S36311 pop_frac * [S36311] of myself * foi
        let delta-S36312 pop_frac * [S36312] of myself * foi
        let delta-S36122 pop_frac * [S36122] of myself * foi
        let delta-S36111 pop_frac * [S36111] of myself * foi
        let delta-S36112 pop_frac * [S36112] of myself * foi
        let delta-S17311 pop_frac * [S17311] of myself * foi
        let delta-S17312 pop_frac * [S17312] of myself * foi
        let delta-S17111 pop_frac * [S17111] of myself * foi
        let delta-S17112 pop_frac * [S17112] of myself * foi
        let delta-S18311 pop_frac * [S18311] of myself * foi
        let delta-S18312 pop_frac * [S18312] of myself * foi
        let delta-S18111 pop_frac * [S18111] of myself * foi
        let delta-S18112 pop_frac * [S18112] of myself * foi
        let delta-S19111 pop_frac * [S19111] of myself * foi

        ask myself [

            set S00000 (S00000 - delta-S00000)
            set E00000 (E00000 + delta-S00000)

            set S11112 (S11112 - delta-S11112)
            set E11112 (E11112 + delta-S11112)

            set S12112 (S12112 - delta-S12112)
            set E12112 (E12112 + delta-S12112)

            set S13112 (S13112 - delta-S13112)
            set E13112 (E13112 + delta-S13112)

            set S14212 (S14212 - delta-S14212)
            set E14212 (E14212 + delta-S14212)

            set S14112 (S14112 - delta-S14112)
            set E14112 (E14112 + delta-S14112)

            set S15111 (S15111 - delta-S15111)
            set E15111 (E15111 + delta-S15111)

            set S26311 (S26311 - delta-S26311)
            set E26311 (E26311 + delta-S26311)

            set S26312 (S26312 - delta-S26312)
            set E26312 (E26312 + delta-S26312)

            set S26111 (S26111 - delta-S26111)
            set E26111 (E26111 + delta-S26111)

            set S26112 (S26112 - delta-S26112)
            set E26112 (E26112 + delta-S26112)

            set S36322 (S36322 - delta-S36322)
            set E36322 (E36322 + delta-S36322)

            set S36311 (S36311 - delta-S36311)
            set E36311 (E36311 + delta-S36311)

            set S36312 (S36312 - delta-S36312)
            set E36312 (E36312 + delta-S36312)

            set S36122 (S36122 - delta-S36122)
            set E36122 (E36122 + delta-S36122)

            set S36111 (S36111 - delta-S36111)
            set E36111 (E36111 + delta-S36111)

            set S36112 (S36112 - delta-S36112)
            set E36112 (E36112 + delta-S36112)

            set S17311 (S17311 - delta-S17311)
            set E17311 (E17311 + delta-S17311)

            set S17312 (S17312 - delta-S17312)
            set E17312 (E17312 + delta-S17312)

            set S17111 (S17111 - delta-S17111)
            set E17111 (E17111 + delta-S17111)

            set S17112 (S17112 - delta-S17112)
            set E17112 (E17112 + delta-S17112)

            set S18311 (S18311 - delta-S18311)
            set E18311 (E18311 + delta-S18311)

            set S18312 (S18312 - delta-S18312)
            set E18312 (E18312 + delta-S18312)

            set S18111 (S18111 - delta-S18111)
            set E18111 (E18111 + delta-S18111)

            set S18112 (S18112 - delta-S18112)
            set E18112 (E18112 + delta-S18112)

            set S19111 (S19111 - delta-S19111)
            set E19111 (E19111 + delta-S19111)

            set totalnewinfected totalnewinfected + delta-S00000 + delta-S11112 + delta-S12112 +
                delta-S13112 + delta-S14212 + delta-S14112 + delta-S15111 + delta-S26311 +
                delta-S26312 + delta-S26111 + delta-S26112 + delta-S36322 + delta-S36311 +
                delta-S36312 + delta-S36122 + delta-S36111 + delta-S36112 + delta-S17311 +
                delta-S17312 + delta-S17111 + delta-S17112 + delta-S18311 + delta-S18312 +
                delta-S18111 + delta-S18112 + delta-S19111
        ]
    ]
end