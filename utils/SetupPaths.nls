globals [
  output-dir
  output-file
  input-dir
  gm-shp-file
  biblebelt-shp-file
  ggdpoints-shp-file
  ggdregio-shp-file
  imm-startpop-file
  farm-shp-file
  farm-iv-file
  commuter-links-file
  school-links-file
  travelneigh-links-file
  travelnonneigh-links-file
  age-file
  economic-file
  infc-within-summer-file
  infc-within-springaut-file
  infc-within-wint-file
  infc-among-summer-file
  infc-among-springaut-file
  infc-among-wint-file
  wfoi-csv-file
]


to init-paths
  init-input-paths
  init-output-paths
end

to init-output-paths
  set output-dir "data/output/"
  set output-file (word output-dir "OutputBasemodel_" output-nr ".csv")
end

to init-input-paths
  set input-dir "data/input/"
  
  ; Spatial layer
  set gm-shp-file (word input-dir "spatial_layers/Gemeentes2013TrMr.shp")
  set biblebelt-shp-file (word input-dir "spatial_layers/BiblebeltTrMr.shp")
  set ggdpoints-shp-file (word input-dir "spatial_layers/GGDpointsTrMr.shp")
  set ggdregio-shp-file (word input-dir "spatial_layers/GGDregioTrMr.shp")

  ; Raster files for disease type 2 using kernel
  set wfoi-csv-file (word input-dir "foi/weighted_foi.csv")

  ; Immunity
  set imm-startpop-file (word input-dir "imm_startpop/" Immunity-Startpopulation)
  
  ; Farm
  set farm-shp-file (word input-dir "farm_data/outbreak_" animal-inf-oubtreak-nr "/preprocessed_farm.shp")
  set farm-iv-file (word input-dir "farm_data/outbreak_" animal-inf-oubtreak-nr "/iv_table.csv")

  ; Links
  set commuter-links-file (word input-dir "links/LinksCommuter.txt")
  set school-links-file (word input-dir "links/LinksSchool.txt")
  set travelneigh-links-file (word input-dir "links/LinksTravelNeigh.txt")
  set travelnonneigh-links-file (word input-dir "links/LinksTravelNonNeigh.txt")

  ; Others- age and economic
  set age-file (word input-dir "others/AgeScore.txt")
  set economic-file (word input-dir "others/EconomicScore.txt")

  ; Transmission rates
  set infc-within-summer-file (word input-dir "trans/" Infection-Rate-WithinMuni-Summer)
  set infc-within-springaut-file (word input-dir "trans/" Infection-Rate-WithinMuni-SpringAutumn)
  set infc-within-wint-file (word input-dir "trans/" Infection-Rate-WithinMuni-Winter)
  
  set infc-among-summer-file (word input-dir "comm_trans/" Infection-Rate-AmongMuni-Summer)
  set infc-among-springaut-file (word input-dir "comm_trans/" Infection-Rate-AmongMuni-SpringAutumn)
  set infc-among-wint-file (word input-dir "comm_trans/" Infection-Rate-AmongMuni-Winter)


end
