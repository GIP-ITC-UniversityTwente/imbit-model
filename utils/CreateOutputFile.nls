  file-type "S19111;E19111;I19111;R19111;"
end

to setup-output-file-groups-population-size
  ;file-type "sum05;"
  ;file-type "sum55;"
  ;file-type "sum512;"
  ;file-type "sum1217;"
  ;file-type "sum1725;"
  ;file-type "sum2535;"
  ;file-type "sum3550;"
  ;file-type "sum5065;"
  ;file-type "sum65;"
end

to write-output-row
  ; Basic columns
  file-type (word ticks ";" name ";" xcor ";" ycor ";" totalnewinfected)

  ; Extended group columns
